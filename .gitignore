.env
.env.*
!.env.example
*.key
*_key
*.pem
service_account*.json
**/secrets/

# --- python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- OS / editor ---
.DS_Store
*.swp

# --- transient eval outputs (baseline lives in a pinned file, not these) ---
evals/report_azure_smoke.json
evals/report_scratch*.json

# --- local-only notes, kept out of the repo ---
docs/interview-notes.md
docs/explain.md
docs/system-design.tex
docs/system-design.pdf

# --- portal screenshots (show real resource names / subscription id) ---
docs/*.png

# --- terraform (state + tfvars hold secrets/ids) ---
infra/.terraform/
infra/.terraform.lock.hcl
*.tfstate
*.tfstate.*
infra/terraform.tfvars
