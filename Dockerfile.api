# Backend: FastAPI over answer_question.
FROM python:3.11-slim

WORKDIR /app

# CPU-only torch keeps the image ~1.5GB instead of ~5GB (no CUDA on the target runner).
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Bake the embedding model into the image so the first request doesn't stall on a
# model download (matters for scale-to-zero / cold starts).
RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('sentence-transformers/all-MiniLM-L6-v2')"

COPY app/ ./app/
COPY api/ ./api/
COPY prompts/ ./prompts/

EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
